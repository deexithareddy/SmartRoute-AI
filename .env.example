# ==============================================================================
# SmartRoute AI - Environment Configuration Example
# Copy this file to .env and configure values for your deployment.
# NEVER commit actual secrets, API tokens, or production credentials.
# ==============================================================================

# Server Environment Mode: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Server Debug Mode (Always set to false in production to prevent traceback leaks)
DEBUG=false

# Allowed CORS Origins (comma-separated origins for web dashboard access)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Maximum Request Body Payload Size in bytes (1MB = 1048576)
MAX_REQUEST_SIZE_BYTES=1048576

# Database Connection URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./smartroute.db

# External Routing & Geocoding Service Endpoints
OSRM_BASE_URL=http://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Routing & Geocoding Provider API Keys (Placeholders ONLY - NEVER commit real keys)
GEOAPIFY_API_KEY=your_geoapify_api_key_here
HERE_API_KEY=your_here_api_key_here
MUNICIPAL_TRAFFIC_API_KEY=your_traffic_api_key_here
MAPS_API_KEY=your_maps_api_key_here

# Fault Injection for Live Demo (DISABLED automatically in production)
ALLOW_DEV_FAULT_INJECTION=true

